  "learning_rate": 0.001,
  "radiance_gradient_floor": 0.000001,
  "seed": 7,
  "num_workers": 0,
  "cpu_threads": 4,
  "train_groups": [
    "breakfast_room_view_00_right_orbit_slow",
    "dragon_view_01_left_dolly_slow"
  ],
  "validation_groups": [
    "bathroom_view_00_dolly_medium",
    "classroom_view_02_linear_fast"
  ]
}
